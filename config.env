# Single settings file for the site. Edit values here, then run: python3 build.py
# APP_NAME is a working name. Use the {{APP_NAME}} token in all texts; change it here when the store name is chosen.
APP_NAME=Evenzo
SUPPORT_EMAIL=miselylab@gmail.com
DEVELOPER_NAME=Mehmet İlyas İnce (Miselylab)
# SITE_URL: GitHub Pages address, no trailing slash.
SITE_URL=https://inceilyas.github.io/evenzo-site
YEAR=2026
# ENABLED_LANGS: languages that are published (switcher, hreflang, build, check). Add a code only when its four pages are final.
# Codes: en,tr,de,fr,it,es,pt-BR,ru,ja,ko,zh-Hant. Languages not listed are built only on request (python3 build.py de) and are git-ignored.
ENABLED_LANGS=en
# Effective date of the privacy policy and terms, written in each language's own style: EFFECTIVE_DATE_<KEY>.
# Update all of them whenever the legal text changes in a meaningful way. Add the other keys (TR, DE, FR, IT, ES, PT_BR, RU, JA, KO, ZH_HANT) with the translations.
EFFECTIVE_DATE_EN=November 10, 2026
